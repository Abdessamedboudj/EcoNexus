{
    "version": 2,
    "builds": [
        {
            "src": "myrobot/wsgi.py",
            "use": "@vercel/python",
            "config": { 
                "maxLambdaSize": "50mb",
                "runtime": "python3.9"
            }
        },
        {
            "src": "build_files.sh",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "static"
            }
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/api/(.*)",
            "dest": "myrobot/wsgi.py"
        },
        {
            "src": "/(.*)",
            "dest": "myrobot/wsgi.py"
        }
    ],
    "env": {
        "DJANGO_SETTINGS_MODULE": "myrobot.settings",
        "ALLOWED_HOSTS": ".vercel.app",
        "DJANGO_DEBUG": "False",
        "VERCEL_ENV": "production",
        "PYTHONPATH": "/var/task"
    }
}
