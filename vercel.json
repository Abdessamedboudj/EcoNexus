{
    "version": 2,
    "builds": [
        {
            "src": "myrobot/wsgi.py",
            "use": "@vercel/python",
            "config": { 
                "maxLambdaSize": "50mb",
                "runtime": "python3.9",
                "buildCommand": "pip install -r requirements.txt"
            }
        },
        {
            "src": "static/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/static/(.*)",
            "dest": "/static/$1"
        },
        {
            "src": "/(.*)",
            "dest": "myrobot/wsgi.py"
        }
    ],
    "env": {
        "DJANGO_SETTINGS_MODULE": "myrobot.settings",
        "ALLOWED_HOSTS": ".vercel.app",
        "DJANGO_DEBUG": "False",
        "VERCEL_ENV": "production",
        "PYTHONPATH": "/var/task"
    },
    "functions": {
        "api/generate-pdf": {
            "memory": 1024,
            "maxDuration": 10
        }
    }
}
